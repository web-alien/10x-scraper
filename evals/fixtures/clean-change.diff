+/**
+ * Formatuje datę publikacji do czytelnej, lokalnej postaci (pl-PL).
+ * Czysta funkcja — bez efektów ubocznych, zależności od runtime'u i I/O.
+ */
+export function formatPublishedAt(date: Date): string {
+  return new Intl.DateTimeFormat("pl-PL", { dateStyle: "medium" }).format(date);
+}
+
+/** Zwraca liczbę słów w tekście (do szacowania czasu czytania). */
+export function wordCount(text: string): number {
+  return text.trim() === "" ? 0 : text.trim().split(/\s+/).length;
+}
