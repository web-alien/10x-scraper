---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import ArticlesTable from "@/components/ArticlesTable";
import { createClient } from "@/lib/supabase";
import { fetchArticles } from "@/lib/services/articles";

import type { Tables } from "@/types/supabase";

type Article = Tables<"articles_seen">;

let articles: Article[] = [];
let fetchError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase) {
  fetchError = "Brak konfiguracji Supabase — sprawdź zmienne środowiskowe.";
} else {
  const { data, error } = await fetchArticles(supabase);
  if (error) {
    fetchError = `Błąd pobierania artykułów: ${error.message}`;
  } else {
    articles = data;
  }
}
---

<Layout title="Artykuły — Panel">
  <div class="bg-cosmic min-h-screen p-6 text-white">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex items-center gap-4">
        <a
          href="/dashboard"
          class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
        >
          ← Panel
        </a>
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Artykuły
        </h1>
      </div>

      {fetchError && <Banner variant="error">{fetchError}</Banner>}

      <div class="rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
        <ArticlesTable articles={articles} client:load />
      </div>
    </div>
  </div>
</Layout>
